{
  "name": "copa-ataci",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "wrangler pages dev dist --port 8788 --ip 127.0.0.1",
    "preapi": "node scripts/db-ensure.mjs",
    "dev:full": "npm run build && (npm run api & sleep 3 && npm run dev)",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist",
    "prepreview": "node scripts/db-ensure.mjs",
    "db:ensure": "node scripts/db-ensure.mjs",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workerd": "cd test-workerd && npm install --silent && npm test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "db:schema": "wrangler d1 execute copa-ataci --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute copa-ataci --local --file=./db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "db:schema:remote": "wrangler d1 execute copa-ataci --remote --file=./db/schema.sql",
    "db:seed:remote": "wrangler d1 execute copa-ataci --remote --file=./db/seed.sql",
    "db:migrate": "wrangler d1 migrations apply copa-ataci --local",
    "db:migrate:remote": "wrangler d1 migrations apply copa-ataci --remote"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "html2canvas": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
